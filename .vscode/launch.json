{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Run All",
            "configurations": [
                "C#: CineControl.CinemaService.API Debug",
                "C#: CineControl.IdentityService.API Debug",
                "C#: CineControl.SeanceService.API Debug"
            ]
        }
    ],
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/src/CineControl"
        },
        {
            "name": "C#: CineControl.CinemaService.API Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/CineControl.CinemaService.API/CineControl.CinemaService.API.csproj"
        },
        {
            "name": "C#: CineControl.IdentityService.API Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/CineControl.IdentityService.API/CineControl.IdentityService.API.csproj"
        },
        {
            "name": "C#: CineControl.SeanceService.API Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/CineControl.SeanceService.API/CineControl.SeanceService.API.csproj"
        },
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/CineControl.IdentityService.API/bin/Debug/net8.0/CineControl.IdentityService.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/CineControl.IdentityService.API",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "Docker .NET Launch",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "netCore": {
                "appProject": "${workspaceFolder}/src/CineControl.IdentityService.API/CineControl.IdentityService.API.csproj"
            }
        }
    ]
}