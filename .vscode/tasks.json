{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ng: start",
            "type": "shell",
            "command": "yarn --cwd src/CineControl start"
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/CineControl.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/CineControl.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/CineControl.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "DropDB",
            "type": "shell",
            "command": "dotnet-ef",
            "args": [
                "database",
                "drop",
                "--project",
                "${workspaceFolder}/src/${input:project}",
                "-f"
            ]
        },
        {
            "label": "UpdateDB",
            "type": "shell",
            "command": "dotnet-ef",
            "args": [
                "database",
                "update",
                "--project",
                "${workspaceFolder}/src/${input:project}"
            ]
        },
        {
            "label": "RefreshDB",
            "dependsOn": [
                "DropDB",
                "UpdateDB"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "project",
            "type": "pickString",
            "description": "Pick a project",
            "options": [
                "CineControl.CinemaService.API",
                "CineControl.IdentityService.API",
                "CineControl.SeanceService.API"
            ]
        }
    ]
}