@using CineControl.AdminPanel.Models.DTO.Tenant
@model IEnumerable<GetTenantResponse>
@{
    ViewData["Title"] = "Tenant Page";
}

<h1>Tenants</h1>
<p>
    <a asp-action="Create" 
        class="btn btn-primary">Add Tenant</a>
</p>
<table> 
    <thead> 
        <tr> 
            <th>@Html.DisplayNameFor(m => m.First().Name)</th>
            <th>@Html.DisplayNameFor(m => m.First().Description)</th> 
            <th>Options</th>
        </tr> 
    </thead> 
    <tbody> 
        @foreach (var tenant in Model) 
        { 
            <tr> 
                <td>
                    @Html.DisplayFor(tenantitem => tenant.Name)
                </td> 
                <td>
                    @Html.DisplayFor(tenantitem => tenant.Description)
                </td> 
                <td>
                    <a asp-action="Edit" asp-route-id="@tenant.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@tenant.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@tenant.Id">Delete</a>
                </td> 
            </tr> 
        } 
    </tbody>
</table>