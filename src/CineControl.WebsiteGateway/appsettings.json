// https://microsoft.github.io/reverse-proxy/articles/config-files.html
{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": { //route name
        "ClusterId": "identityservice", //cluster name
        // "CorsPolicy": "customPolicy",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms":  [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "cinema": { //route name
        "ClusterId": "cinemaservice", //cluster name
        // "CorsPolicy": "customPolicy",
        "Match": {
          "Path": "/cinema/{**catch-all}"
        },
        "Transforms":  [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "seance": { //route name
        "ClusterId": "seanceservice", //cluster name
        // "CorsPolicy": "customPolicy",
        "Match": {
          "Path": "/seance/{**catch-all}"
        },
        "Transforms":  [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "booking": { //route name
        "ClusterId": "bookingservice", //cluster name
        // "CorsPolicy": "customPolicy",
        "Match": {
          "Path": "/booking/{**catch-all}"
        },
        "Transforms":  [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "tenant": { //route name
        "ClusterId": "tenantservice", //cluster name
        // "CorsPolicy": "customPolicy",
        "Match": {
          "Path": "/tenant/{**catch-all}"
        },
        "Transforms":  [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identityservice": { //cluster name
        "Destinations": {
          "default": { //destination name
            "Address": "http://identityservice:8080" 
          }
        }
      },
      "cinemaservice": {
        "Destinations": {
          "default": { //destination name
            "Address": "http://cinemaservice:8080" 
          }
        }
      },
      "seanceservice": {
        "Destinations": {
          "default": { //destination name
            "Address": "http://seanceservice:8080" 
          }
        }
      },
      "bookingservice": {
        "Destinations": {
          "default": { //destination name
            "Address": "http://bookingservice:8080" 
          }
        }
      },
      "tenantservice": {
        "Destinations": {
          "default": { //destination name
            "Address": "http://tenantservice:8080" 
          }
        }
      }    
    }
  }
}
