// https://microsoft.github.io/reverse-proxy/articles/config-files.html
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "route1": { //route name
        "ClusterId": "cluster1", //cluster name
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cluster1": { //cluster name
        "Destinations": {
          "default": { //destination name
            "Address": "http://localhost:5093/swagger/index.html"
          }
        }
      }
    }
  }
}
