@using CineControl.OperatorPanel.Models.DTOs.Cinemas
@model AddCinemaRequest
@{
    ViewData["Title"] = "Add Cinema";
}

<div class="text-center">
    <h1 class="display-4">Add new Cinema</h1>
    <form asp-action="Create" asp-controller="Cinema" method="post">
        <label asp-for="Name"></label>
        <input asp-for="Name"><br>
        <label asp-for="Address"></label>
        <input asp-for="Address"><br>
        <label asp-for="City"></label>
        <input asp-for="City"><br>
        <label asp-for="State"></label>
        <input asp-for="State"><br>
        <label asp-for="ZipCode"></label>
        <input asp-for="ZipCode"><br>
        <button type="submit">Add Cinema</button>
    </form>
</div>
