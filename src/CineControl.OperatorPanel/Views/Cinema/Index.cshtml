@using CineControl.OperatorPanel.Models.DTOs.Cinemas
@model IEnumerable<GetCinemaResponse>
@{
    ViewData["Title"] = "Cinema Page";
}

<h1>Cinemas</h1>
<p>
    <a asp-controller="Cinema" asp-action="Create" class="button">Add Cinema</a>
</p>
<table> 
    <thead> 
        <tr> 
            <th>@Html.DisplayNameFor(m => m.First().Name)</th>
            <th>@Html.DisplayNameFor(m => m.First().Address)</th> 
            <th>@Html.DisplayNameFor(m => m.First().City)</th> 
            <th>@Html.DisplayNameFor(m => m.First().State)</th> 
            <th>@Html.DisplayNameFor(m => m.First().ZipCode)</th> 
            <th>Options</th>
        </tr> 
    </thead> 
    <tbody> 
        @foreach (var cinema in Model) 
        { 
            <tr> 
                <td>
                    @Html.DisplayFor(cinemaitem => cinema.Name)
                </td> 
                <td>
                    @Html.DisplayFor(cinemaitem => cinema.Address)
                </td> 
                <td>
                    @Html.DisplayFor(cinemaitem => cinema.City)
                </td> 
                <td>
                    @Html.DisplayFor(cinemaitem => cinema.State)
                </td> 
                <td>
                    @Html.DisplayFor(cinemaitem => cinema.ZipCode)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@cinema.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@cinema.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@cinema.Id">Delete</a>
                </td> 
            </tr> 
        } 
    </tbody>
</table>