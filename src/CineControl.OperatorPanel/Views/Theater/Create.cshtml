@using CineControl.OperatorPanel.Models.DTOs.Theaters
@model AddTheaterRequest
@{
    ViewData["Title"] = "Add Theater";
}

<div class="text-center">
    <h1 class="display-4">Add new Theater</h1>
    <form asp-action="Create" asp-controller="Theater" method="post">
        @Html.AntiForgeryToken()
        <label asp-for="Name"></label>
        <input asp-for="Name"><br>
        <label asp-for="SeatingCapacity"></label>
        <input asp-for="SeatingCapacity"><br>
        <label asp-for="SeatsPerRow"></label>
        <input asp-for="SeatsPerRow"><br>
        <button type="submit">Add Theater</button>
    </form>
</div>
