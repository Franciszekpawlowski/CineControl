@using CineControl.OperatorPanel.Models.DTOs.Theaters
@model GetTheaterResponse
@{
    ViewData["Title"] = "Delete Theater";
}
<h1>Delete</h1>

<h3>Are you sure you want to delete this Theater?</h3>
<hr />
<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SeatingCapacity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SeatingCapacity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SeatsPerRow)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SeatsPerRow)
        </dd>
    </dl>
        
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CinemaId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Details"
            asp-controller="Cinema"
            asp-route-Id="@Model.CinemaId"
            class="btn btn-primary">Back to List</a>
    </form>
</div>