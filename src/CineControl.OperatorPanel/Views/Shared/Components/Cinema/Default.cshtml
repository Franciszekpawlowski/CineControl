@using CineControl.OperatorPanel.Models.Components;
@model CinemaViewModel

<form asp-controller="Cinema" 
    asp-action="Details" 
    method="get"
    class="form-inline">
    <div class="form-group mb-2">
        <label asp-for="id" class="sr-only">Select Cinema</label>
        <select 
            asp-for="id" 
            asp-items="@Model.selectListItems"
            onchange="this.form.submit()"
            class="form-control"></select>

    </div>
</form>