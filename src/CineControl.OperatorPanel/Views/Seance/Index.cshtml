@using CineControl.OperatorPanel.Models.DTOs.Seances
@model IEnumerable<GetSeanceResponse>
@{
    ViewData["Title"] = "Seance Page";
}

<h1>Seance</h1>
<p>
    <a asp-controller="Cinema" asp-action="Create" class="button">Add Cinema</a>
</p>
<table> 
    <thead> 
        <tr> 
            <th>@Html.DisplayNameFor(m => m.First().MovieTitle)</th>
            <th>@Html.DisplayNameFor(m => m.First().PosterUrl)</th> 
            <th>@Html.DisplayNameFor(m => m.First().StartTime)</th> 
            <th>@Html.DisplayNameFor(m => m.First().EndTime)</th> 
            <th>Options</th>
        </tr> 
    </thead> 
    <tbody> 
        @foreach (var seance in Model) 
        { 
            <tr> 
                <td>
                    @Html.DisplayFor(seanceitem => seance.MovieTitle)
                </td> 
                <td>
                    @Html.DisplayFor(seanceitem => seance.PosterUrl)
                </td> 
                <td>
                    @Html.DisplayFor(seanceitem => seance.StartTime)
                </td> 
                <td>
                    @Html.DisplayFor(seanceitem => seance.EndTime)
                </td> 
                <td>
                    <a asp-action="Edit" asp-route-id="@seance.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@seance.Id">Details</a>
                    <a asp-action="Delete" asp-route-id="@seance.Id">Delete</a>
                </td> 
            </tr> 
        } 
    </tbody>
</table>