@using CineControl.OperatorPanel.Models.UserLogin;
@model UserLoginRequest
@{
    ViewData["Title"] = "Login Page";
}

<div class="text-center login-container">
    <h1 class="display-4">Welcome</h1>
    <p>Login into OperatorPanel.</p>
    <form asp-action="Login" asp-controller="Auth" method="post">
        @Html.AntiForgeryToken()
        <div>
            <label asp-for="Username"></label>
            <input asp-for="Username"><br>
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Password"></label>
            <input asp-for="Password"><br>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <button type="submit">Login in</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}