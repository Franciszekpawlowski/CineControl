@CineControl.CinemaService.API_HostAddress = http://localhost:5112
# @CineControl.CinemaService.API_HostAddress = http://gateway.cinecontrol.local/cinema


POST {{CineControl.CinemaService.API_HostAddress}}/api/v1/Cinemas
Content-Type: application/json
X-TenantId: 3fa85f64-5717-4562-b3fc-2c963f66afa6

{
  "name": "test",
  "address": "testowa2",
  "city": "test",
  "state": "test",
  "zipCode": "21-902"
}

###
# @name GetCinemas
GET {{CineControl.CinemaService.API_HostAddress}}/api/v1/Cinemas
Content-Type: application/json
X-TenantId: 3fa85f64-5717-4562-b3fc-2c963f66afa6

###
@cinemaId = {{GetCinemas.response.body.$.[0].id}}
GET {{CineControl.CinemaService.API_HostAddress}}/api/v1/Cinemas/{{cinemaId}}
Content-Type: application/json
X-TenantId: 3fa85f64-5717-4562-b3fc-2c963f66afa6

###
# @name cities
GET {{CineControl.CinemaService.API_HostAddress}}/api/v1/Cinemas/cities
Content-Type: application/json
X-TenantId: 3fa85f64-5717-4562-b3fc-2c963f66afa6

###
@city = {{cities.response.body.$.cities.[0]}}
GET {{CineControl.CinemaService.API_HostAddress}}/api/v1/Cinemas/ByCity/{{city}}
Content-Type: application/json
X-TenantId: 3fa85f64-5717-4562-b3fc-2c963f66afa6

###

PUT {{CineControl.CinemaService.API_HostAddress}}/api/v1/Cinemas/{{cinemaId}}
Content-Type: application/json
X-TenantId: 3fa85f64-5717-4562-b3fc-2c963f66afa6

{
  "name": "test",
  "address": "testowa14",
  "city": "test",
  "state": "test",
  "zipCode": "21-902"
}

###

DELETE {{CineControl.CinemaService.API_HostAddress}}/api/v1/Cinemas/{{cinemaId}}
Content-Type: application/json
X-TenantId: 3fa85f64-5717-4562-b3fc-2c963f66afa6

